HELP.md
target/
.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/

# Secrets — never commit real API keys
secrets.properties
.env

### STS ###
.apt_generated
.classpath
.factorypath
.project
.settings
.springBeans
.sts4-cache

# IDE — .idea/ is tracked selectively (see .idea/.gitignore) so the Maven
# import + JDK config travels with the repo, same convention as yoda-keyword-extractor
*.iws
*.iml
*.ipr

### NetBeans ###
/nbproject/private/
/nbbuild/
/dist/
/nbdist/
/.nb-gradle/
build/
!**/src/main/**/build/
!**/src/test/**/build/

### VS Code ###
.vscode/

# Playwright / demo artifacts
playwright-report/
test-results/
screenshots/actual/
screenshots/diff/
recordings/
*.log
/.idea/

# retired assets, pending permanent deletion
.retired-2026-10-14/

# Full-size source videos — GitHub rejects >100MB and warns >50MB.
# Only the trimmed cuts in docs/ are committed; keep originals local.
docs/ORIG*.mp4
docs/__pycache__/

# Private talk material — conference logistics and personal delivery notes.
# Explicitly ignored so a stray `git add .` can never publish them.
docs/TALK-TODO.md
docs/SPEAKING-GUIDE.md

# Slide sources and exported slide images: ~124MB of binaries, and the deck
# is distributed by the conference, not from here.
docs/slide-assets/

# Office lock/backup files
~$*
*.bk
