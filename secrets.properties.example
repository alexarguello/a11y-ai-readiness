# Copy this file to secrets.properties and fill in your keys.
# secrets.properties is gitignored and must never be committed.
#
# The loader reads environment variables FIRST, then this file, so you can
# instead export ANTHROPIC_API_KEY / XAI_API_KEY and leave this file empty.

# Anthropic — https://console.anthropic.com
# Note: a Claude Pro/Max subscription does NOT include API access.
# API usage is billed separately via pay-as-you-go credit on the console.
anthropic.api.key=

# xAI / Grok — https://console.x.ai
# Used through Spring AI's OpenAI-compatible client.
xai.api.key=

# Which provider the agent uses: anthropic | xai | ollama
agent.provider=anthropic

# Hard cap on agent turns per task, so a looping agent cannot run forever.
agent.max.turns=15

# Runs per UI variant. Keep at 5 or more: LLM runs are stochastic and the
# methodology reports median and spread, never a single run.
agent.runs.per.variant=5
