# Copy this file to secrets.properties and fill in your keys.
# secrets.properties is gitignored and must never be committed.
#
# The loader reads environment variables FIRST, then this file, so you can
# instead export ANTHROPIC_API_KEY / XAI_API_KEY and leave this file empty.

# Anthropic — https://console.anthropic.com
# Note: a Claude Pro/Max subscription does NOT include API access.
# API usage is billed separately via pay-as-you-go credit on the console.
anthropic.api.key=

# xAI / Grok — https://console.x.ai
# Used through Spring AI's OpenAI-compatible client.
xai.api.key=

# Which provider the agent uses by default: xai | anthropic (override per run with --provider=)
agent.provider=xai

# Model defaults are hardcoded per provider in AgentRunner (grok-4.6 / claude-sonnet-5) --
# override a specific run with --model=, there's no single global property for this.

# Hard cap on agent tool calls per task, so a looping agent cannot run forever.
# This is a runaway safety net, NOT a scoring mechanism -- the metric is how many calls a run
# actually needed, which the model produces by deciding it is finished. A run that hits the cap
# is flagged budgetExhausted and excluded as spoiled data, so setting this too LOW doesn't make
# the broken variant look worse -- it just throws the run away. Size it clear of BOTH variants'
# known needs, not just the easy one: /accessible settles at ~11 calls, but Grok's /inaccessible
# needed 28 calls to give up on its own in testing -- a cap of 15 excluded 5/5 real runs in a
# multi-run pass (docs/PLAN.md §12 task 8 notes). 40 clears that with margin.
agent.max.turns=40

# Recommended runs per UI variant for the multi-run pass -- not auto-applied (multi-run is
# opt-in only, so a stray value here can't silently trigger extra API spend). Pass it explicitly:
#   --agent.run=true --runs=5 --provider=xai
# Keep at 5 or more: LLM runs are stochastic and the methodology reports median and spread,
# never a single run.
agent.runs.per.variant=5
